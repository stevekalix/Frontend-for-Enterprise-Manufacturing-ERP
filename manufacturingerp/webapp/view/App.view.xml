<mvc:View controllerName="com.manufacturing.erp.manufacturingerp.controller.App"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m">
    <tnt:ToolPage id="toolPage" sideExpanded="true">
        <tnt:header>
            <tnt:ToolHeader>
                <Button id="sideNavigationToggleButton"
                    icon="sap-icon://menu"
                    type="Transparent"
                    press=".onSideNavButtonPress"
                    tooltip="{i18n>tooltipToggleNavigation}" />
                <Image src="https://www.sap.com/dam/application/shared/logos/sap-logo-svg.svg" height="24px" class="sapUiSmallMarginBegin" />
                <VBox class="sapUiTinyMarginBegin">
                    <Title text="{i18n>appTitle}" level="H1" />
                    <Text text="{i18n>appSubtitle}" class="sapUiTinyMarginTop" />
                </VBox>
                <ToolbarSpacer />
                <Button icon="sap-icon://bell" type="Transparent" press=".onNotificationPress" tooltip="{i18n>tooltipNotifications}" />
                <Button icon="sap-icon://customer" text="{i18n>userName}" type="Transparent" press=".onProfilePress" tooltip="{i18n>tooltipProfile}" />
                <Button icon="sap-icon://log" type="Transparent" press=".onLogoutPress" tooltip="{i18n>tooltipLogout}" />
            </tnt:ToolHeader>
        </tnt:header>
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" selectedKey="dashboard" itemSelect=".onSideNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="{i18n>navDashboard}" icon="sap-icon://home" key="dashboard" />
                    <tnt:NavigationListItem text="{i18n>navProducts}" icon="sap-icon://product" key="product" />
                    <tnt:NavigationListItem text="{i18n>navBOM}" icon="sap-icon://clinical-tasty-recipe" key="bom" />
                    <tnt:NavigationListItem text="{i18n>navSuppliers}" icon="sap-icon://shipping-status" key="supplier" />
                    <tnt:NavigationListItem text="{i18n>navMaterials}" icon="sap-icon://factory" key="material" />
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <App id="app" />
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
